<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Job Label -->
    <key>Label</key>
    <string>com.redhat.kernel.monthly</string>

    <!-- Program to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/anareddy/Desktop/Claude_Agentic_Kernel_Publication/monthly_kernel_report.py</string>
    </array>

    <!-- Working Directory -->
    <key>WorkingDirectory</key>
    <string>/Users/anareddy/Desktop/Claude_Agentic_Kernel_Publication</string>

    <!-- Environment Variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SMTP_SERVER</key>
        <string>smtp.gmail.com</string>
        <key>SMTP_PORT</key>
        <string>587</string>
        <key>SENDER_EMAIL</key>
        <string>anand.itsmee@gmail.com</string>
        <key>RECIPIENT_EMAIL</key>
        <string>anareddy@redhat.com</string>
        <!-- SMTP_PASSWORD: Set via environment variable in ~/.zshrc or use .env_email file -->
        <!-- SECURITY: NEVER commit passwords to git! -->
        <!-- Option 1: Add to ~/.zshrc: export SMTP_PASSWORD="your-app-password" -->
        <!-- Option 2: Create .env_email file (git-ignored) with: SMTP_PASSWORD=your-app-password -->
    </dict>

    <!-- Schedule: Run on 1st of every month at 9:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <!-- Hour: 9 AM -->
        <key>Hour</key>
        <integer>9</integer>
        <!-- Minute: 0 -->
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Users/anareddy/Desktop/Claude_Agentic_Kernel_Publication/logs/monthly_report.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/anareddy/Desktop/Claude_Agentic_Kernel_Publication/logs/monthly_report_error.log</string>

    <!-- Run on load (optional - for testing) -->
    <!-- Remove or set to false for production -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Keep job running -->
    <key>KeepAlive</key>
    <false/>

    <!-- Process management -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Session Type -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
